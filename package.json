{
  "name": "patchoath",
  "version": "0.3.0",
  "private": true,
  "description": "Make every AI patch prove it stayed in scope — explicit authority, Git evidence, human review, and controlled disclosure.",
  "type": "module",
  "bin": {
    "patchoath": "./bin/patchoath.mjs",
    "vibetrace": "./bin/vibetrace.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "README.md",
    "LICENSE",
    "LEGAL.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "patchoath": "node bin/patchoath.mjs",
    "check": "node scripts/check.mjs",
    "rights:check": "node scripts/rights-check.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run rights:check && npm test && npm run test:e2e"
  },
  "keywords": [
    "ai-coding",
    "developer-tools",
    "git",
    "code-review",
    "agent-safety",
    "change-control",
    "evidence",
    "vibe-coding",
    "blast-radius"
  ],
  "homepage": "https://github.com/feifeing/vibetrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feifeing/vibetrace.git"
  },
  "bugs": {
    "url": "https://github.com/feifeing/vibetrace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6"
  },
  "license": "MIT"
}
